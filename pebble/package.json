{
  "name": "arcminute-complications",
  "author": "MakeAwesomeHappen",
  "version": "1.0.0",
  "keywords": [
    "pebble-watchface"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
  "scripts": {
    "install-emulator": "pebble build && pebble install --emulator gabbro --logs",
    "install-phone": "pebble build && pebble install --cloudpebble"
  },
  "pebble": {
    "displayName": "Arcminute Complications",
    "uuid": "7a4a2270-121f-465e-9fcf-ed6f7c284727",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [
      "configurable",
      "location"
    ],
    "messageKeys": [
      "BG_HEX",
      "FACE_HEX",
      "HAND_HEX",
      "FACE_CLEAR",
      "DIAL_STYLE",
      "THICK_HAND",
      "COMP_MODE",
      "TEMP_UNIT",
      "TEMP_VALUE",
      "WEATHER_REQUEST"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": true,
          "type": "png",
          "name": "APP_ICON",
          "file": "images/app_icon.png"
        },
        {
          "type": "font",
          "name": "FONT_HELVETICA_95",
          "file": "fonts/Helvetica-Digits.ttf",
          "characterRegex": "[0-9]"
        }
      ]
    },
    "manifestVersion": 1
  }
}